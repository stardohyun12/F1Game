# === Unity (F1/ 안쪽 자동 생성물) ===
F1/[Ll]ibrary/
F1/[Tt]emp/
F1/[Oo]bj/
F1/[Bb]uild/
F1/[Bb]uilds/
F1/[Ll]ogs/
F1/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size
F1/[Mm]emoryCaptures/

# Recordings can get excessive in size
F1/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!F1/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# F1/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
F1/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
F1/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
F1/ExportedObj/
F1/.consulo/
F1/*.csproj
F1/*.unityproj
F1/*.sln
F1/*.slnx
F1/*.suo
F1/*.tmp
F1/*.user
F1/*.userprefs
F1/*.pidb
F1/*.booproj
F1/*.svd
F1/*.pdb
F1/*.mdb
F1/*.opendb
F1/*.VC.db

# Unity3D generated meta files
F1/*.pidb.meta
F1/*.pdb.meta
F1/*.mdb.meta

# Unity3D generated file on crash reports
F1/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
F1/crashlytics-build.properties

# Packed Addressables
F1/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
F1/[Aa]ssets/[Ss]treamingAssets/aa.meta
F1/[Aa]ssets/[Ss]treamingAssets/aa/*

# === 공통 OS / Editor ===
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.nfs*

# JetBrains
.idea/

# VS Code (기본 설정은 공유, 개인 설정은 제외)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# === 세션 스크래치 ===
# Claude/Cowork 세션 폴더 (만약 생기면)
.claude/cache/
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/settings.local.json
# F1 폴더 안의 로컬 .claude는 프로젝트 allowlist와 분리 (개인 Unity 작업용)
F1/.claude/

# === 세션 24 추가 — 생성물/스크래치 ===
# Unity 검증용 생성 스크린샷 (unity-cli screenshot / CaptureFullScreen)
F1/Captures/
F1/Screenshots/
# 루트 자동 생성 솔루션 (F1/*.sln은 이미 무시, 루트는 별도)
/PitCrew.sln
# 루트에 잘못 생긴 Obsidian 설정 (실제 vault는 옵시디언/)
/.obsidian/
# Obsidian workspace 상태 — 개인별·노이즈
옵시디언/.obsidian/workspace.json
# 스크래치/프로브
_probe.txt
/files/

# Superpowers brainstorming visual companion
.superpowers/

# game-craft-upgrade ③ 자동 스크린샷 — 로컬 검증용, repo 미포함
docs/screenshots/auto/

# AI 생성 API 키 — 로컬 전용, 절대 커밋 금지
.env.local
.env
*.key
secrets/

# 자산 카탈로그 HTML — base64 임베드라 무거움, 로컬 뷰어용 (md는 추적)
docs/asset-catalog-*.html

# 스튜디오 대시보드 런타임 로그 (state.json·server.py는 추적)
tools/studio-dashboard/server.log
tools/studio-dashboard/activity.jsonl

# 스튜디오 허브 페이지(생성된 목업)·로그 — 추적 안 함
tools/studio-dashboard/pages/
*.blend1
captures/art/
tools/studio-dashboard/running.json
